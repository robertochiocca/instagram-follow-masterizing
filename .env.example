# Copie para ".env" (ou exporte no terminal) e ajuste. NUNCA coloque valores reais aqui.
# Todas as variáveis são opcionais.

# Pasta onde ficam o banco SQLite e as imagens privadas (padrão: ./data)
IGT_DATA_DIR=./data

# Tamanho máximo por imagem, em MB (padrão: 15; teto absoluto: 50)
IGT_MAX_UPLOAD_MB=15

# Senha de acesso à interface. Recomendada se a porta for exposta na rede
# ou publicamente. Vazio = sem senha. Escolha uma senha sua (não use exemplos).
# Se a senha tiver "#", escreva-a entre aspas: IGT_APP_PASSWORD="minha#senha"
IGT_APP_PASSWORD=

# Nível de log (DEBUG, INFO, WARNING, ERROR). Logs nunca contêm imagens ou conteúdo privado.
IGT_LOG_LEVEL=INFO

# Fuso horário usado para datas padrão (padrão: America/Sao_Paulo)
IGT_TIMEZONE=America/Sao_Paulo
